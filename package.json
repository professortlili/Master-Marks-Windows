{
    "name": "master-marks",
    "version": "1.3.0",
    "author": "Professor TLILI Mohamed Lamine",
    "description": "Master-Marks - Official Version",
    "main": "electron-main.js",
    "scripts": {
        "start": "electron .",
        "obfuscate": "node obfuscate-all.js",
        "build:scorebook": "electron-builder --config electron-builder-scorebook.json",
