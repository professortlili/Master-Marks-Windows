    },
    "devDependencies": {
        "electron": "^25.0.0",
        "electron-builder": "^26.8.1",
        "javascript-obfuscator": "^4.2.2"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^6.4.0"
    }
}